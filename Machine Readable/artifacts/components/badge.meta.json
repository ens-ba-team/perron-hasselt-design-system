  "accessibility": {
    "role": "none",
    "screenReader": "Text content is read as-is. Always include a visible label.",
    "colorAlone": "Never rely on colour alone to communicate meaning.",
    "icons": "Leading and trailing icons are decorative and should use aria-hidden=true.",
    "dynamicContent": "Notification counters, Online, and Offline variants update in real time — wrap in role=status or aria-live=polite. Static variants do not need aria-live.",
    "presenceDot": "The dot-slot in Online and Offline is decorative — mark with aria-hidden=true. The label text carries the accessible meaning.",
    "notificationCap": "Cap Notification counters display at 99+ to prevent layout overflow."
  },
  "constraints": [
    "Badge is non-interactive by default.",
    "Badge must not be wrapped in a button to become clickable.",
    "Use tag from combobox for dismissible or selectable chips.",
    "Status and presence variants use Pill shape only.",
    "Online must include visible text such as Online or Available."
  ],
  "bestPractice": {
    "useCases": [
      "Displaying the status of a record in a table row ('Active', 'Expired', 'Pending review')",
      "Labelling a list item with a category or tag ('Design', 'Engineering', 'Billing')",
      "Showing an unread notification count on a sidebar nav item or inbox icon",
      "Indicating user presence next to a name in a team list ('Online', 'Away')",
      "Marking a new or recently changed item with a 'New' or 'Updated' label",
      "Flagging a failed or blocked state on a data record ('Failed', 'Blocked')"
    ],
    "variantExamples": {
