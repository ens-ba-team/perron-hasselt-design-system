          "Failed",
          "Deleted",
          "Rejected",
          "Blocked"
        ]
      },
      "Success": {
        "whenToUse": "Positive or healthy state — item is active or complete",
        "examples": [
          "Active",
          "Connected",
          "Completed",
          "Live"
        ]
      },
      "Error": {
        "whenToUse": "Soft recoverable error — needs attention but not critical",
        "examples": [
          "Invalid",
          "Expired",
          "Limit Reached"
        ]
      },
      "Warning": {
        "whenToUse": "Caution — something needs attention before it fails",
        "examples": [
          "Expiring Soon",
          "Low Balance",
          "Needs Review"
        ]
      },
      "Blue": {
        "whenToUse": "Informational or in-progress — neutral signal, no urgency",
        "examples": [
          "In Progress",
          "Pending",
          "Syncing"
        ]
      },
      "Online": {
        "whenToUse": "User or entity is currently available",
        "examples": [
          "Online",
          "Available",
          "Active now"
        ]
      },
      "Offline": {
        "whenToUse": "User or entity is absent or unavailable",
        "examples": [
          "Offline",
          "Away",
          "Unavailable"
        ]
      },
      "Notification counters": {
        "whenToUse": "Unread count on a nav item or icon",
        "examples": [
          "3",
          "12",
          "99+ on a mail icon or sidebar item"
        ]
      }
    },
    "comparedTo": [
      {
        "situation": "The label needs to be dismissible by the user (a selected filter chip, a tag in a combobox)",
        "use": "tag",
        "notInstead": "badge (badge has no interactive states and cannot be dismissed)"
      },
      {
        "situation": "The label needs to be clickable to trigger navigation or filtering",
        "use": "tag or button Type=Ghost",
        "notInstead": "badge (badge is display-only; wrapping in a button breaks accessible semantics)"
      },
      {
        "situation": "User presence changes in real time and needs screen reader announcement",
        "use": "badge Variant=Online/Offline with aria-live=polite",
        "notInstead": "a static colored dot without a label (colour alone is never sufficient)"
