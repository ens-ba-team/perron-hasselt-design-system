  "constraints": [
    "Use maximum one Default button per page section.",
    "Secondary only appears alongside a Default button.",
    "Link type is navigation only.",
    "Destructive actions that are irreversible require a confirmation dialog.",
    "Icon-only sizes always require a tooltip.",
    "Do not override fills manually on button instances."
  ],
  "bestPractice": {
    "useCases": [
      "Submitting a form (creating a project, saving settings, sending a message)",
      "Triggering a destructive action that opens a confirmation dialog (deleting a record, revoking access)",
      "Providing the primary call-to-action in a hero section or onboarding step",
      "Opening an overlay — a dialog, sheet, or drawer — via a clearly labelled button",
      "Performing a toolbar or in-context action (formatting text, adding a row, running a filter)",
      "Navigating to a new route when the destination is the primary next step in a flow (Type=Link only)"
    ],
    "variantExamples": {
      "Default": {
        "whenToUse": "The single most important action on the current view",
        "examples": [
          "Create Project in an empty state",
          "Save Changes in settings",
          "Confirm in a dialog footer"
        ]
      },
      "Outline": {
        "whenToUse": "Neutral cancel/back/dismiss, or parallel uncolored actions alongside Default",
        "examples": [
          "Cancel next to Save Changes",
          "Back in a multi-step wizard",
          "Import next to Create"
        ]
      },
      "Secondary": {
        "whenToUse": "Lighter-weight branded parallel action alongside Default — NOT cancel/back/dismiss",
        "examples": [
          "Preview next to Publish",
          "Export next to Generate"
        ]
      },
      "Ghost": {
        "whenToUse": "Low-priority supplementary action in a dense or contextual space",
        "examples": [
          "Edit inside a card",
          "Clear in a filter bar",
          "toolbar icon actions"
        ]
      },
      "Link": {
        "whenToUse": "Pure navigation — takes the user to a new route",
        "examples": [
          "View documentation",
          "See all results",
          "Go to billing"
        ]
      },
      "Destructive": {
        "whenToUse": "Permanently removes or irreversibly modifies data",
        "examples": [
          "Delete Project",
          "Revoke API key",
          "Remove member"
        ]
      }
    },
    "comparedTo": [
      {
        "situation": "User needs to navigate to a different page or route",
        "use": "button Type=Link",
        "notInstead": "navigation-menu (use nav-menu for multi-item top nav; Link button for single inline link)"
      },
      {
        "situation": "Two or more related actions that belong together visually (Bold / Italic, Grid / List)",
        "use": "button-group",
        "notInstead": "button placed side by side without grouping"
      },
      {
        "situation": "Inline anchor text within a paragraph",
        "use": "button Type=Link or a plain <a>",
        "notInstead": "button Type=Default (fills draw too much weight in running text)"
      }
    ],
    "references": {
