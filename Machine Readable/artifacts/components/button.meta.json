        "Default": "default",
        "Outline": "outline",
        "Secondary": "secondary",
        "Ghost": "ghost",
        "Link": "link",
        "Destructive": "destructive"
      },
      "intent": {
        "Default": "Principal call to action. Use once per page or section.",
        "Outline": "Neutral cancel/back/dismiss, or uncolored parallel action. Use Outline for Cancel — not Secondary.",
        "Secondary": "Lighter-weight branded parallel action paired with Default. NOT for cancel/back/dismiss.",
        "Ghost": "Lowest-emphasis supplementary or toolbar action.",
        "Link": "Navigation only. Do not use for data mutation.",
        "Destructive": "Permanent delete, remove, stop, or revoke action."
      }
    },
    "State": {
      "type": "enum",
      "values": [
        "Enabled",
        "Hover",
        "Focus",
        "Disabled",
        "Active"
