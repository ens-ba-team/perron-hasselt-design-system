{
  "button": {
    "primary": {
      "bg": {
        "bg": {
          "$value": "{color.brand.primary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.primary-hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.primary-active}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.primary.foreground}",
          "$type": "color"
        }
      }
    },
    "secondary": {
      "bg": {
        "bg": {
          "$value": "{color.brand.secondary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.secondary-hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.secondary-active}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.secondary.foreground}",
          "$type": "color"
        }
      }
    },
    "destructive": {
      "bg": {
        "bg": {
          "$value": "{color.brand.destructive}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.destructive-hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.destructive-active}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.destructive.foreground}",
          "$type": "color"
        }
      }
    },
    "outline": {
      "bg": {
        "bg": {
          "$value": "{color.background.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.background.accent}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.background.accent}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.background.default.foreground}",
          "$type": "color"
        }
      },
      "border": {
        "default": {
          "$value": "{color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.border.hover}",
          "$type": "color"
        },
        "focus": {
          "$value": "{color.ring}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.border.strong}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.border.disabled}",
          "$type": "color"
        }
      }
    },
    "ghost": {
      "bg": {
        "hover": {
          "$value": "{color.background.accent}",
          "$type": "color"
        },
        "bg": {
          "$value": "{color.background.default}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.background.accent}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.background.default.foreground}",
          "$type": "color"
        }
      }
    },
    "link": {
      "fg": {
        "default": {
          "$value": "{color.text.link}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.text.link-hover}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.disabled}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.text.link-active}",
          "$type": "color"
        }
      }
    },
    "size": {
      "Button radius 1": {
        "$value": "{radius.xl}",
        "$type": "number",
        "$description": "Corner radius for Large and Icon Large (11px = radius/xl)"
      },
      "Button radius 2": {
        "$value": "{radius.base}",
        "$type": "number",
        "$description": "Corner radius for Small, Default, Icon Small, Icon Default (8px = radius/base)"
      },
      "Button-height-default": {
        "$value": "{spacing.10}",
        "$type": "dimension",
        "$description": "Height for Default button (40px) — shadcn default"
      },
      "Button-height-small": {
        "$value": "{spacing.9}",
        "$type": "dimension",
        "$description": "Height for Small button (36px) — shadcn sm"
      },
      "Button-height-large": {
        "$value": "{spacing.11}",
        "$type": "dimension",
        "$description": "Height for Large button (44px) — shadcn lg, meets 44px touch target"
      },
      "Button spacing": {
        "$value": "{spacing.component.xs}",
        "$type": "number",
        "$description": "Gap between icon and label — all sizes (4px)"
      },
      "Button-padding-default": {
        "$value": "{spacing.4}",
        "$type": "dimension",
        "$description": "Horizontal padding for Default and Large (16px)"
      },
      "Button-padding-small": {
        "$value": "{spacing.3}",
        "$type": "dimension",
        "$description": "Horizontal padding for Small (12px)"
      }
    }
  },
  "badge": {
    "Badge-height-small": {
      "$value": "{spacing.4}",
      "$type": "dimension",
      "$description": "Badge-height-small for small badge variant"
    },
    "Badge-height-medium": {
      "$value": "{spacing.5}",
      "$type": "dimension",
      "$description": "Badge-height-small for medium badge variant"
    },
    "Badge-height-large": {
      "$value": "{spacing.6}",
      "$type": "dimension",
      "$description": "Badge-height-small for large badge variant"
    }
  },
  "table": {
    "table-cell-compact": {
      "$value": "{spacing.10}",
      "$type": "dimension",
      "$description": "table-cell height for compact variant"
    },
    "table-cell-default": {
      "$value": "{spacing.12}",
      "$type": "dimension",
      "$description": "table-cell height for default variant"
    }
  },
  "tooltip": {
    "bg": {
      "$value": "{color.zinc.900}",
      "$type": "color"
    },
    "fg": {
      "$value": "{color.white}",
      "$type": "color"
    }
  }
}